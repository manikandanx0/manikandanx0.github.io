---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const blog = (await getCollection("blog", ({ data }) => !data.draft)).map(
  (e) => ({ ...e, kind: "blog" }),
);
const leetcode = (
  await getCollection("leetcode", ({ data }) => !data.draft)
).map((e) => ({ ...e, kind: "leetcode" }));
const ctf = (await getCollection("ctf", ({ data }) => !data.draft)).map(
  (e) => ({ ...e, kind: "ctf" }),
);

const allWriting = [...blog, ...leetcode, ...ctf];

// Sector tag sets
const blogTags = Array.from(
  new Set(blog.flatMap((e) => e.data.tags || [])),
).sort();
const leetcodeTags = Array.from(
  new Set(leetcode.flatMap((e) => e.data.tags || [])),
).sort();
const ctfTags = Array.from(
  new Set(ctf.flatMap((e) => e.data.tags || [])),
).sort();

// Map unique tags with associated sectors
const allTagObjects = Array.from(
  new Set([...blogTags, ...leetcodeTags, ...ctfTags]),
)
  .sort()
  .map((tag) => {
    const sectors: string[] = [];
    if (blogTags.includes(tag)) sectors.push("blog");
    if (leetcodeTags.includes(tag)) sectors.push("leetcode");
    if (ctfTags.includes(tag)) sectors.push("ctf");
    return { tag, sectors: sectors.join(" ") };
  });
---

<BaseLayout
  title="Writing Hub"
  description="Archive of Blog posts, Interview Prep Code Logs, and CTF writeups."
>
  <div class="container container--wide page">
    <!-- Header & Telemetry -->
    <header class="writing-hero anim-up">
      <div class="hero-main-panel">
        <p class="hero-tag">// TRANSMISSION HUB · KNOWLEDGE MATRIX</p>
        <h1 class="hero-title">WRITING &amp; LOGS</h1>
        <p class="hero-sub">
          Centralized archive of technical research essays, algorithmic
          problem-solving logs for interview preparation, and security challenge
          writeups.
        </p>
      </div>

      <!-- Sector Counters Telemetry -->
      <div class="telemetry-bar">
        <div class="sector-stat">
          <span class="stat-lbl">BLOGS</span>
          <span class="stat-num">{blog.length.toString().padStart(2, "0")}</span
          >
        </div>
        <div class="sector-stat">
          <span class="stat-lbl">CODE LOGS (DSA)</span>
          <span class="stat-num"
            >{leetcode.length.toString().padStart(2, "0")}</span
          >
        </div>
        <div class="sector-stat">
          <span class="stat-lbl">CTF WRITEUPS</span>
          <span class="stat-num">{ctf.length.toString().padStart(2, "0")}</span>
        </div>
      </div>
    </header>

    <!-- Sector & Dynamic Tag Filter Controls -->
    <div class="filter-container anim-up anim-d1">
      <div class="filter-row">
        <span class="filter-lbl">// SECTOR:</span>
        <div class="filter-buttons">
          <button class="filter-btn sector-btn active" data-sector-filter="all"
            >ALL TRANSMISSIONS ({allWriting.length})</button
          >
          <button class="filter-btn sector-btn" data-sector-filter="blog"
            >BLOGS ({blog.length})</button
          >
          <button class="filter-btn sector-btn" data-sector-filter="leetcode"
            >CODE LOGS ({leetcode.length})</button
          >
          <button class="filter-btn sector-btn" data-sector-filter="ctf"
            >CTF WRITEUPS ({ctf.length})</button
          >
        </div>
      </div>

      <!-- Dynamic Tag Filters Row -->
      <div
        class="filter-row"
        style="margin-top: 10px; border-top: 1px dashed var(--border); padding-top: 10px;"
      >
        <span class="filter-lbl">// TAG FILTER:</span>
        <div class="filter-buttons" id="tag-buttons-container">
          <button
            class="filter-btn tag-btn active"
            data-tag-filter="all"
            data-tag-sectors="blog leetcode ctf">ALL TAGS</button
          >
          {
            allTagObjects.map((item) => (
              <button
                class="filter-btn tag-btn"
                data-tag-filter={item.tag.toLowerCase()}
                data-tag-sectors={item.sectors}
              >
                {item.tag.toUpperCase()}
              </button>
            ))
          }
        </div>
      </div>
    </div>

    <!-- SECTOR 01: BLOGS & ESSAYS -->
    <section
      class="writing-sector anim-up anim-d2"
      data-sector="blog"
      data-empty={blog.length === 0 ? "true" : "false"}
    >
      <div class="sector-header">
        <div class="sector-title-group">
          <span class="sector-badge">SECTOR 01</span>
          <h2>BLOGS &amp; RESEARCH ESSAYS</h2>
        </div>
        <span class="sector-desc"
          >Notes on systems architecture, AI research, engineering philosophy,
          and personal logs.</span
        >
      </div>

      <div class="sector-grid">
        {
          blog.length === 0 && (
            <article class="card sector-card empty-card" data-tags="">
              <div class="card-head">
                <span>BLOG-00 // ESSAY</span>
                <span class="card-head-id">PENDING</span>
              </div>
              <div class="sector-card-body">
                <h3 class="card-title" style="color: var(--muted); opacity: 0.75;">
                  [ TRANSMISSION PENDING ]
                </h3>
                <p class="card-text">
                  Technical essays, systems architecture notes, and personal logs are currently in progress.
                </p>
                <div class="sector-meta-bar">
                  <span class="tag" style="opacity:0.6;">COMING SOON</span>
                </div>
              </div>
            </article>
          )
        }

        {
          blog.map((post, i) => (
            <article
              class="card sector-card"
              data-tags={(post.data.tags || []).join(" ").toLowerCase()}
              style={`animation-delay:${0.1 + i * 0.06}s`}
            >
              <div class="card-head">
                <span>BLOG-{String(i + 1).padStart(2, "0")} // ESSAY</span>
                <span class="card-head-id">
                  {post.data.date.toLocaleDateString("en-US", {
                    month: "short",
                    year: "numeric",
                  })}
                </span>
              </div>
              <div class="sector-card-body">
                <h3 class="card-title">{post.data.title}</h3>
                <p class="card-text">
                  {post.data.excerpt || "Personal engineering essay."}
                </p>
                <div class="sector-meta-bar">
                  {post.data.tags?.map((t: string) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
                <a
                  class="card-link"
                  href={`/writing/blog/${post.id.replace(/\.md$/, "")}`}
                >
                  Read Post ↗
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- SECTOR 02: CODE LOGS / INTERVIEW PREP (DSA) -->
    <section
      class="writing-sector anim-up anim-d3"
      data-sector="leetcode"
      data-empty={leetcode.length === 0 ? "true" : "false"}
    >
      <div class="sector-header">
        <div class="sector-title-group">
          <span class="sector-badge">SECTOR 02</span>
          <h2>CODE LOGS &amp; INTERVIEW PREP (DSA)</h2>
        </div>
        <span class="sector-desc"
          >LeetCode patterns, data structure implementations, and time/space
          complexity breakdowns.</span
        >
      </div>

      <div class="sector-grid">
        {
          leetcode.length === 0 && (
            <article class="card sector-card empty-card" data-tags="">
              <div class="card-head">
                <span>LC-000 // LOG_SLOT</span>
                <span class="card-head-id">PENDING</span>
              </div>
              <div class="sector-card-body">
                <h3 class="card-title" style="color: var(--muted); opacity: 0.75;">
                  [ TRANSMISSION PENDING ]
                </h3>
                <p class="card-text">
                  Algorithmic code logs and interview prep breakdowns are currently in progress.
                </p>
                <div class="sector-meta-bar">
                  <span class="tag" style="opacity:0.6;">COMING SOON</span>
                </div>
              </div>
            </article>
          )
        }

        {
          leetcode.map((post, i) => (
            <article
              class="card sector-card"
              data-tags={(post.data.tags || []).join(" ").toLowerCase()}
              style={`animation-delay:${0.1 + i * 0.06}s`}
            >
              <div class="card-head">
                <span>
                  LC-{String(post.data.problemNumber || i + 1).padStart(3, "0")}{" "}
                  // DSA_LOG
                </span>
                <span class="card-head-id">
                  {post.data.difficulty?.toUpperCase() || "MEDIUM"}
                </span>
              </div>
              <div class="sector-card-body">
                <h3 class="card-title">{post.data.title}</h3>

                {(post.data.timeComplexity || post.data.spaceComplexity) && (
                  <div class="complexity-bar">
                    {post.data.timeComplexity && (
                      <span class="comp-badge">
                        TIME: {post.data.timeComplexity}
                      </span>
                    )}
                    {post.data.spaceComplexity && (
                      <span class="comp-badge">
                        SPACE: {post.data.spaceComplexity}
                      </span>
                    )}
                  </div>
                )}

                <p class="card-text">
                  {post.data.excerpt ||
                    "Algorithmic approach and problem solution."}
                </p>

                <div class="sector-meta-bar">
                  {post.data.tags?.map((t: string) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
                <a
                  class="card-link"
                  href={`/writing/leetcode/${post.id.replace(/\.md$/, "")}`}
                >
                  Inspect Solution ↗
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    <!-- SECTOR 03: CTF WRITEUPS & SECURITY LABS -->
    <section
      class="writing-sector anim-up anim-d4"
      data-sector="ctf"
      data-empty={ctf.length === 0 ? "true" : "false"}
    >
      <div class="sector-header">
        <div class="sector-title-group">
          <span class="sector-badge">SECTOR 03</span>
          <h2>CTF WRITEUPS &amp; SECURITY LABS</h2>
        </div>
        <span class="sector-desc"
          >Exploit walkthroughs, CTF challenges, reverse engineering, and web
          vulnerability analysis.</span
        >
      </div>

      <div class="sector-grid">
        {
          ctf.length === 0 && (
            <article class="card sector-card empty-card" data-tags="">
              <div class="card-head">
                <span>CTF-00 // LOG_SLOT</span>
                <span class="card-head-id">PENDING</span>
              </div>
              <div class="sector-card-body">
                <h3 class="card-title" style="color: var(--muted); opacity: 0.75;">
                  [ TRANSMISSION PENDING ]
                </h3>
                <p class="card-text">
                  Security research and CTF challenge writeups are currently in progress.
                </p>
                <div class="sector-meta-bar">
                  <span class="tag" style="opacity:0.6;">COMING SOON</span>
                </div>
              </div>
            </article>
          )
        }

        {
          ctf.map((post, i) => (
            <article
              class="card sector-card"
              data-tags={(post.data.tags || []).join(" ").toLowerCase()}
              style={`animation-delay:${0.1 + i * 0.06}s`}
            >
              <div class="card-head">
                <span>CTF-{String(i + 1).padStart(2, "0")} // WRITEUP</span>
                <span class="card-head-id">
                  {post.data.event || "SECURITY"}
                </span>
              </div>
              <div class="sector-card-body">
                <h3 class="card-title">{post.data.title}</h3>
                <p class="card-text">
                  {post.data.excerpt ||
                    "Security incident writeup and flag analysis."}
                </p>
                <div class="sector-meta-bar">
                  {post.data.difficulty && (
                    <span class="tag tag--filled">
                      {post.data.difficulty.toUpperCase()}
                    </span>
                  )}
                  {post.data.tags?.map((t: string) => (
                    <span class="tag">{t}</span>
                  ))}
                </div>
                <a
                  class="card-link"
                  href={`/writing/ctf/${post.id.replace(/\.md$/, "")}`}
                >
                  Read Writeup ↗
                </a>
              </div>
            </article>
          ))
        }
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  /* ── Writing Hero — asymmetric ──────────────────────────── */
  /*
    Main panel: cols 1-8
    Telemetry:  cols 9-13, offset down 24px
    Combined they form one composition, not two equal boxes.
  */
  .writing-hero {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 12px;
    align-items: start;
    margin-bottom: 32px;
    position: relative;
  }

  .hero-main-panel {
    grid-column: 1 / 9;
    background: rgba(14, 15, 30, 0.95);
    border: 1px solid var(--border3);
    padding: 28px 32px;
    position: relative;
  }
  .hero-main-panel::before {
    content: "";
    position: absolute; top: -1px; left: -1px;
    width: 18px; height: 18px;
    border-top: 2px solid var(--purple);
    border-left: 2px solid var(--purple);
    pointer-events: none;
  }

  .hero-tag { font-size: 11px; letter-spacing: 0.16em; color: var(--muted); margin-bottom: 8px; font-weight: 600; }
  .hero-title {
    font-size: clamp(26px, 4vw, 40px);
    color: var(--white); letter-spacing: 0.04em;
    margin-bottom: 12px; line-height: 1.1; font-weight: 700;
  }
  .hero-sub { font-size: 13.5px; color: var(--text); line-height: 1.75; opacity: 0.95; }

  /* Telemetry — right column, offset down */
  .telemetry-bar {
    grid-column: 9 / 13;
    margin-top: 24px;
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border2);
    background: rgba(14, 15, 30, 0.95);
  }

  .sector-stat {
    flex: 1; padding: 14px 18px;
    display: flex; justify-content: space-between; align-items: center;
    border-bottom: 1px solid var(--border);
  }
  .sector-stat:last-child { border-bottom: none; }
  .stat-lbl { font-size: 10px; letter-spacing: 0.12em; color: var(--muted); font-weight: 600; }
  .stat-num { font-size: 20px; font-weight: 700; color: var(--white); letter-spacing: -0.02em; }

  /* connector line between hero-main-panel and telemetry-bar */
  .writing-hero::after {
    content: '';
    position: absolute;
    top: 0;
    left: calc((8/12 * 100%) + 6px);
    width: 1px; height: 24px;
    background: linear-gradient(to bottom, var(--border3), transparent);
    pointer-events: none;
  }

  /* ── Filter Controls — inset from left ──────────────────── */
  .filter-container {
    grid-column: 1 / -1;
    border: 1px solid var(--border2);
    border-left: 3px solid var(--purple);
    padding: 12px 16px;
    margin-bottom: 44px;
    background: rgba(14, 15, 30, 0.92);
  }

  .filter-row { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .filter-lbl { font-size: 10px; letter-spacing: 0.14em; color: var(--muted); min-width: 80px; font-weight: 600; }
  .filter-buttons { display: flex; gap: 6px; flex-wrap: wrap; }

  .filter-btn {
    background: rgba(20, 22, 42, 0.7);
    border: 1px solid var(--border2);
    color: var(--muted); font-family: var(--font);
    font-size: 10.5px; letter-spacing: 0.1em; font-weight: 500;
    padding: 5px 12px; cursor: pointer;
    transition: border-color 0.2s, color 0.2s, background 0.2s;
    text-transform: uppercase;
  }
  .filter-btn:hover { border-color: var(--border3); color: var(--white); background: rgba(30, 32, 60, 0.8); }
  .filter-btn.active { border-color: var(--purple); color: var(--white); background: rgba(159,135,255,0.18); font-weight: 600; }

  /* ── Sector Layout — asymmetric per sector ───────────────── */
  .writing-sector { margin-bottom: 52px; }

  .sector-header {
    display: flex; align-items: baseline; gap: 14px;
    margin-bottom: 16px; padding-bottom: 10px;
    border-bottom: 1px solid var(--border);
    position: relative;
  }
  .sector-header::after {
    content: '';
    position: absolute;
    bottom: -1px; right: -24px;
    width: 24px; height: 1px;
    background: linear-gradient(to right, var(--border), transparent);
    pointer-events: none;
  }

  .sector-title-group { display: flex; align-items: center; gap: 8px; }
  .sector-title-group h2 { font-size: 16px; letter-spacing: 0.08em; margin: 0; color: var(--white); font-weight: 700; }

  .sector-badge {
    font-size: 9px; font-weight: 700; letter-spacing: 0.14em;
    padding: 2px 6px;
    border: 1px solid var(--border3);
    color: var(--violet); flex-shrink: 0;
  }
  .sector-desc { font-size: 12px; color: var(--muted); margin-left: auto; text-align: right; max-width: 280px; }

  /* Sector grid — asymmetric per sector */
  .sector-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 12px; row-gap: 10px;
  }

  /* CTF sector: alternating wide/narrow */
  [data-sector="ctf"] .sector-grid .sector-card:nth-child(odd)  { grid-column: 1 / 8; }
  [data-sector="ctf"] .sector-grid .sector-card:nth-child(even) { grid-column: 6 / 13; margin-top: 20px; }

  /* Leetcode sector: offset start */
  [data-sector="leetcode"] .sector-grid .sector-card:nth-child(odd)  { grid-column: 2 / 9; }
  [data-sector="leetcode"] .sector-grid .sector-card:nth-child(even) { grid-column: 7 / 13; margin-top: 16px; }

  /* Blog sector: wide cards, slight right offset */
  [data-sector="blog"] .sector-grid .sector-card:nth-child(odd)  { grid-column: 1 / 9; }
  [data-sector="blog"] .sector-grid .sector-card:nth-child(even) { grid-column: 4 / 13; margin-top: 16px; }

  /* First card in any sector is always full-prominence */
  .sector-grid .sector-card:first-child { grid-column: 1 / 10 !important; margin-top: 0 !important; }

  .sector-card {
    background: rgba(14, 15, 30, 0.95);
    border: 1px solid var(--border2);
    display: flex; flex-direction: column;
    position: relative;
    transition: border-color 0.2s, transform 0.2s;
  }
  .sector-card::before {
    content: '';
    position: absolute; top: -1px; left: -1px;
    width: 7px; height: 7px;
    border-top: 1px solid var(--border3);
    border-left: 1px solid var(--border3);
    pointer-events: none;
    transition: width 0.2s, height 0.2s;
  }
  .sector-card:hover { border-color: var(--border3); transform: translateY(-1px); }
  .sector-card:hover::before { width: 12px; height: 12px; border-color: var(--purple); }

  .sector-card-body { padding: 16px 18px; display: flex; flex-direction: column; gap: 8px; flex: 1; }
  .card-title { font-size: 15.5px; font-weight: 700; color: var(--white); margin: 0; letter-spacing: 0.02em; }
  .card-text { font-size: 13px; color: var(--text); line-height: 1.65; margin: 0; flex: 1; opacity: 0.95; }
  .sector-meta-bar { display: flex; flex-wrap: wrap; gap: 5px; }
  .complexity-bar { display: flex; gap: 6px; }
  .comp-badge {
    font-size: 10px; letter-spacing: 0.06em; font-weight: 600;
    color: var(--violet); background: rgba(159,135,255,0.12);
    border: 1px solid var(--border2); padding: 2px 8px;
  }

  /* ── Responsive ─────────────────────────────────────────── */
  @media (max-width: 900px) {
    .writing-hero { grid-template-columns: 1fr; display: flex; flex-direction: column; gap: 12px; }
    .hero-main-panel { grid-column: unset; padding: 22px 20px; }
    .telemetry-bar { grid-column: unset; margin-top: 0; flex-direction: row; }
    .sector-stat { flex: 1; border-bottom: none; border-right: 1px solid var(--border); padding: 12px 14px; }
    .sector-stat:last-child { border-right: none; }
    .writing-hero::after { display: none; }
    .sector-desc { display: none; }

    /* Tag filter pills horizontal scroll fade mask */
    .filter-buttons {
      display: flex;
      flex-wrap: nowrap;
      overflow-x: auto;
      scrollbar-width: none;
      -ms-overflow-style: none;
      mask-image: linear-gradient(to right, black 85%, transparent 100%);
      -webkit-mask-image: linear-gradient(to right, black 85%, transparent 100%);
      padding-bottom: 4px;
      width: 100%;
    }
    .filter-buttons::-webkit-scrollbar { display: none; }
    .filter-btn { flex-shrink: 0; white-space: nowrap; }
  }

  @media (max-width: 768px) {
    .sector-grid { grid-template-columns: 1fr !important; }
    [data-sector="ctf"] .sector-grid .sector-card,
    [data-sector="leetcode"] .sector-grid .sector-card,
    [data-sector="blog"] .sector-grid .sector-card,
    .sector-grid .sector-card:first-child { grid-column: 1 / -1 !important; margin-top: 0 !important; }
    .sector-card-body { padding: 16px; }
    .complexity-bar { flex-wrap: wrap; }

    /* Mobile Stat Blocks — Structured Key-Value Rows */
    .telemetry-bar { display: grid; grid-template-columns: 1fr; border-top: none; }
    .sector-stat {
      display: grid; grid-template-columns: 1fr auto;
      align-items: center; justify-content: space-between;
      border-right: none; border-bottom: 1px solid var(--border);
      padding: 10px 14px; text-align: left;
    }
    .sector-stat:last-child { border-bottom: none; }
    .stat-lbl { font-size: 9.5px; letter-spacing: 0.1em; line-height: 1.2; text-align: left; }
    .stat-num { font-size: 18px; text-align: right; }
  }

  @media (max-width: 580px) {
    .writing-hero { margin-bottom: 24px; }
    .hero-main-panel { padding: 18px 16px; }
    .hero-title { font-size: clamp(22px, 7vw, 32px); margin-bottom: 8px; }

    .filter-container { padding: 10px 12px; margin-bottom: 32px; }
    .filter-row { flex-direction: column; align-items: flex-start; gap: 6px; }
    .filter-lbl { min-width: unset; font-size: 9.5px; }

    .sector-header { flex-direction: column; align-items: flex-start; gap: 6px; margin-bottom: 12px; }
    .sector-title-group h2 { font-size: 14px; }
    .sector-badge { font-size: 8.5px; }
  }
</style>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const sectorBtns = document.querySelectorAll(".sector-btn");
    const tagBtns = document.querySelectorAll(".tag-btn");
    const sectors = document.querySelectorAll(".writing-sector");
    const cards = document.querySelectorAll(".sector-card");

    let activeSector = "all";
    let activeTag = "all";

    function updateVisibleTagButtons() {
      tagBtns.forEach((btn) => {
        const filterVal = btn.getAttribute("data-tag-filter");
        if (filterVal === "all") {
          btn.style.display = "inline-block";
          return;
        }

        const tagSectors = btn.getAttribute("data-tag-sectors") || "";
        if (activeSector === "all" || tagSectors.includes(activeSector)) {
          btn.style.display = "inline-block";
        } else {
          btn.style.display = "none";
        }
      });
    }

    function applyFilters() {
      // Sector filter logic
      sectors.forEach((sec) => {
        const secName = sec.getAttribute("data-sector");
        const secHeader = sec.querySelector(".sector-header");
        const isEmptySector = sec.getAttribute("data-empty") === "true";

        if (activeSector === "all") {
          if (isEmptySector) {
            sec.style.display = "none";
          } else {
            sec.style.display = "block";
            if (secHeader) {
              secHeader.style.display = "none";
            }
          }
        } else if (activeSector === secName) {
          sec.style.display = "block";
          if (secHeader) {
            secHeader.style.display = "flex";
          }
        } else {
          sec.style.display = "none";
        }
      });

      // Tag filter logic
      cards.forEach((card) => {
        const isEmptyCard = card.classList.contains("empty-card");
        if (isEmptyCard) {
          card.style.display = activeSector === "all" ? "none" : "flex";
          return;
        }

        const cardTags = card.getAttribute("data-tags") || "";
        if (activeTag === "all" || cardTags.includes(activeTag)) {
          card.style.display = "flex";
        } else {
          card.style.display = "none";
        }
      });
    }

    // Sector button click handler
    sectorBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        sectorBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeSector = btn.getAttribute("data-sector-filter");

        // Reset tag filter when switching sector
        activeTag = "all";
        tagBtns.forEach((tb) => {
          if (tb.getAttribute("data-tag-filter") === "all") {
            tb.classList.add("active");
          } else {
            tb.classList.remove("active");
          }
        });

        updateVisibleTagButtons();
        applyFilters();
      });
    });

    // Tag button click handler
    tagBtns.forEach((btn) => {
      btn.addEventListener("click", () => {
        tagBtns.forEach((b) => b.classList.remove("active"));
        btn.classList.add("active");
        activeTag = btn.getAttribute("data-tag-filter");
        applyFilters();
      });
    });

    // Initial setup
    updateVisibleTagButtons();
    applyFilters();
  });
</script>
