---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const blog = (await getCollection('blog', ({ data }) => !data.draft)).map((e) => ({ ...e, kind: 'blog' }));
const ctf = (await getCollection('ctf', ({ data }) => !data.draft)).map((e) => ({ ...e, kind: 'ctf' }));
const leetcode = (await getCollection('leetcode', ({ data }) => !data.draft)).map((e) => ({ ...e, kind: 'leetcode' }));

const all = [...blog, ...ctf, ...leetcode].sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

---

<BaseLayout title="Writing" description="Blog posts, CTF writeups, and LeetCode solutions.">
  <section class="container resp-page grid-paper">
    <header class="resp-hero">
      <div>
        <p class="resp-meta-label mono">COLLECTION</p>
        <h1 class="resp-hero-title">WRITING</h1>
        <p class="resp-hero-sub">Blog posts, CTF writeups, and LeetCode notes.</p>
      </div>
      <div class="resp-meta">
        <p class="resp-meta-label mono">TYPES</p>
        <span class="resp-chip">BLOG</span>
        <span class="resp-chip">CTF</span>
        <span class="resp-chip">LEETCODE</span>
      </div>
    </header>

    <div class="resp-card-grid">
      {all.map((entry, i) => (
        <article class="resp-card">
          <div class="resp-card-head mono">POST-{String(i + 1).padStart(2, '0')}</div>
          <div class="resp-card-preview"></div>
          <div class="resp-card-body">
            <h2 class="resp-card-title">{entry.data.title}</h2>
            <p class="resp-card-text">{entry.data.excerpt ?? ''}</p>
            <a class="mono" href={`/writing/${entry.kind}/${entry.id.replace(/\.md$/, '')}`}>READ</a>
          </div>
        </article>
      ))}
      {all.length === 0 && (
        <article class="resp-card">
          <div class="resp-card-head mono">POST-00</div>
          <div class="resp-card-preview"></div>
          <div class="resp-card-body">
            <h2 class="resp-card-title">Nothing published yet</h2>
          </div>
        </article>
      )}
    </div>
  </section>
</BaseLayout>
