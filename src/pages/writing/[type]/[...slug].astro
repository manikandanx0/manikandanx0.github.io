---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const collections = ['blog', 'ctf', 'leetcode'] as const;
  const paths = [];

  for (const type of collections) {
    const entries = await getCollection(type, ({ data }) => !data.draft);
    for (const entry of entries) {
      paths.push({
        params: { type, slug: entry.id.replace(/\.md$/, '') },
        props: { entry, type },
      });
    }
  }

  return paths;
}

const { entry, type } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt ?? `${type} writeup`}>
  <div class="container page">

    <header class="post-hero anim-up">
      <div>
        <p class="post-type">// {type.toUpperCase()} · TRANSMISSION</p>
        <h1 class="post-title">{entry.data.title}</h1>
        <p class="post-date">
          {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
      </div>
      <div class="post-tags">
        <span class="tag tag--filled">{type.toUpperCase()}</span>
        {'difficulty' in entry.data && entry.data.difficulty &&
          <span class="tag">{entry.data.difficulty.toUpperCase()}</span>}
        {'event' in entry.data && entry.data.event &&
          <span class="tag">{entry.data.event}</span>}
        {'problemUrl' in entry.data && entry.data.problemUrl &&
          <a href={entry.data.problemUrl} target="_blank" rel="noopener" class="tag">Problem ↗</a>}
      </div>
    </header>

    <div class="content-panel anim-up anim-d1">
      <div class="panel-head">Content</div>
      <div class="content-inner prose">
        <Content />
      </div>
    </div>

  </div>
</BaseLayout>
