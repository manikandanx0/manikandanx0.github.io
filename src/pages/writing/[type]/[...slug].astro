---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { generateOgImage } from '../../../lib/generateOgImage';

export async function getStaticPaths() {
  const collections = ['blog', 'ctf', 'leetcode'] as const;
  const paths = [];

  for (const type of collections) {
    const entries = await getCollection(type, ({ data }) => !data.draft);
    for (const entry of entries) {
      const slug = entry.id.replace(/\.md$/, '');
      const ogImageRel = `/og/writing/${type}/${slug}.png`;
      const ogImagePath = `public${ogImageRel}`;
      const subtitle = 'excerpt' in entry.data ? (entry.data.excerpt as string) : ('event' in entry.data ? (entry.data.event as string) : undefined);

      await generateOgImage({
        title: entry.data.title,
        type,
        subtitle,
        outputPath: ogImagePath,
      });

      paths.push({
        params: { type, slug },
        props: { entry, type, ogImage: ogImageRel },
      });
    }
  }

  return paths;
}

const { entry, type, ogImage } = Astro.props;
const { Content } = await render(entry);
const description = 'excerpt' in entry.data ? (entry.data.excerpt as string) : `${type.toUpperCase()} writeup`;
---

<BaseLayout title={entry.data.title} description={description} image={ogImage}>
  <div class="container container--wide page">

    <div class="detail-layout g12 anim-up">
      <!-- post-hero: cols 1-9 -->
      <header class="post-hero">
        <p class="post-type">// {type.toUpperCase()} · TRANSMISSION</p>
        <h1 class="post-title">{entry.data.title}</h1>
        <p class="post-date">
          {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
      </header>

      <!-- meta aside: cols 10-12, offset -->
      <aside class="post-meta-aside anim-up anim-d1">
        <span class="tag tag--filled">{type.toUpperCase()}</span>
        {'difficulty' in entry.data && entry.data.difficulty &&
          <span class="tag">{(entry.data.difficulty as string).toUpperCase()}</span>}
        {'event' in entry.data && entry.data.event &&
          <span class="tag">{entry.data.event as string}</span>}
        {'problemUrl' in entry.data && entry.data.problemUrl &&
          <a href={entry.data.problemUrl as string} target="_blank" rel="noopener" class="tag">Problem ↗</a>}
      </aside>

      <!-- content: cols 1-9 -->
      <div class="content-panel anim-up anim-d1">
        <div class="panel-head">Content</div>
        <div class="content-inner prose">
          <Content />
        </div>
      </div>
    </div>

  </div>
</BaseLayout>
