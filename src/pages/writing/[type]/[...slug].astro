---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const collections = ['blog', 'ctf', 'leetcode'] as const;
  const paths = [];

  for (const type of collections) {
    const entries = await getCollection(type, ({ data }) => !data.draft);
    for (const entry of entries) {
      paths.push({
        params: { type, slug: entry.id.replace(/\.md$/, '') },
        props: { entry, type },
      });
    }
  }

  return paths;
}

const { entry, type } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.excerpt ?? `${type} writeup`}>
  <section class="container resp-page grid-paper post-shell">
    <header class="resp-hero">
      <div>
        <p class="mono post-type">{type}</p>
        <h1 class="post-title">{entry.data.title}</h1>
        <p class="post-date mono">
          {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
      </div>
      <div class="resp-meta mono">
        <p class="resp-meta-label">DETAILS</p>
        <span class="resp-chip">{type.toUpperCase()}</span>
        {'difficulty' in entry.data && entry.data.difficulty && <span class="resp-chip">{entry.data.difficulty.toUpperCase()}</span>}
        {'event' in entry.data && entry.data.event && <span class="resp-chip">{entry.data.event}</span>}
        {'problemUrl' in entry.data && entry.data.problemUrl && (
          <p><a href={entry.data.problemUrl} target="_blank" rel="noopener">problem ↗</a></p>
        )}
      </div>
    </header>
    <article class="markdown-panel resp-panel">
      <div class="prose">
        <Content />
      </div>
    </article>
  </section>

  <style>
    .post-shell {
      padding-top: 28px;
      padding-bottom: 42px;
    }
    .post-type {
      color: var(--red);
      font-size: 12px;
      margin: 0 0 8px 0;
      text-transform: uppercase;
      letter-spacing: 0.04em;
    }
    .post-title {
      font-size: clamp(30px, 5vw, 46px);
      margin-bottom: 10px;
    }
    .post-date {
      color: var(--text-muted);
      font-size: 12px;
      margin: 0 0 22px 0;
    }
    .prose {
      font-size: 16px;
      line-height: 1.75;
    }
    .prose :global(pre) {
      border: 2px solid var(--border);
      padding: 14px;
      overflow-x: auto;
      background: var(--bg);
    }
  </style>
</BaseLayout>
