---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { generateOgImage } from '../../../lib/generateOgImage';

export async function getStaticPaths() {
  const collections = ['blog', 'ctf', 'leetcode'] as const;
  const paths = [];

  for (const type of collections) {
    const entries = await getCollection(type, ({ data }) => !data.draft);
    for (const entry of entries) {
      const slug = entry.id.replace(/\.md$/, '');
      const ogImageRel = `/og/writing/${type}/${slug}.png`;
      const ogImagePath = `public${ogImageRel}`;
      const subtitle = 'excerpt' in entry.data ? (entry.data.excerpt as string) : ('event' in entry.data ? (entry.data.event as string) : undefined);

      await generateOgImage({
        title: entry.data.title,
        type,
        subtitle,
        outputPath: ogImagePath,
      });

      paths.push({
        params: { type, slug },
        props: { entry, type, ogImage: ogImageRel },
      });
    }
  }

  return paths;
}

const { entry, type, ogImage } = Astro.props;
const { Content } = await render(entry);
const description = 'excerpt' in entry.data ? (entry.data.excerpt as string) : `${type.toUpperCase()} writeup`;

let headline = entry.data.title;
if (type === 'ctf') {
  headline = `[CTF] ${entry.data.title}`;
} else if (type === 'leetcode' && 'problemNumber' in entry.data) {
  headline = `[LC-${String((entry.data as any).problemNumber).padStart(4, '0')}] ${entry.data.title}`;
}

let postDescription = description;
if (type === 'ctf' && 'event' in entry.data) {
  postDescription = `${(entry.data as any).event}${(entry.data as any).difficulty ? ` · ${String((entry.data as any).difficulty).toUpperCase()}` : ''}`;
} else if (type === 'leetcode' && 'difficulty' in entry.data) {
  postDescription = `${String((entry.data as any).difficulty).toUpperCase()}${(entry.data as any).timeComplexity ? ` · Time: ${(entry.data as any).timeComplexity}` : ''}${(entry.data as any).spaceComplexity ? ` · Space: ${(entry.data as any).spaceComplexity}` : ''}`;
}

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).href;
const fullOgImageUrl = new URL(ogImage, Astro.site).href;

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline,
  description: postDescription,
  author: {
    '@type': 'Person',
    name: 'Manikandan',
    url: new URL('/about/', Astro.site).href,
  },
  datePublished: entry.data.date.toISOString(),
  image: fullOgImageUrl,
  url: canonicalUrl,
};

const typeLabel = type === 'blog' ? 'Blog' : type === 'ctf' ? 'CTF' : 'LeetCode';

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    {
      '@type': 'ListItem',
      position: 1,
      name: 'Home',
      item: new URL('/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 2,
      name: 'Writing',
      item: new URL('/writing/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 3,
      name: typeLabel,
      item: new URL('/writing/', Astro.site).href,
    },
    {
      '@type': 'ListItem',
      position: 4,
      name: entry.data.title,
      item: canonicalUrl,
    },
  ],
};
---

<BaseLayout title={entry.data.title} description={description} image={ogImage} schema={[blogPostingSchema, breadcrumbSchema]}>
  <div class="container container--wide page">

    <div class="detail-layout g12 anim-up">
      <!-- post-hero: full width matching navbar -->
      <header class="post-hero">
        <div class="post-hero-head">
          <p class="post-type">// {type.toUpperCase()} · TRANSMISSION</p>
          <div class="post-hero-tags">
            <span class="tag tag--filled">{type.toUpperCase()}</span>
            {'difficulty' in entry.data && entry.data.difficulty &&
              <span class="tag">{(entry.data.difficulty as string).toUpperCase()}</span>}
            {'event' in entry.data && entry.data.event &&
              <span class="tag">{entry.data.event as string}</span>}
            {'problemUrl' in entry.data && entry.data.problemUrl &&
              <a href={entry.data.problemUrl as string} target="_blank" rel="noopener" class="tag">Problem ↗</a>}
          </div>
        </div>
        <h1 class="post-title">{entry.data.title}</h1>
        <p class="post-date">
          {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
      </header>

      <!-- content: full width matching navbar -->
      <div class="content-panel anim-up anim-d1">
        <div class="panel-head">Content</div>
        <div class="content-inner prose">
          <Content />
        </div>
      </div>
    </div>

  </div>
</BaseLayout>
