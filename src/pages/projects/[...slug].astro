---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { generateOgImage } from '../../lib/generateOgImage';

export async function getStaticPaths() {
  const entries = await getCollection('projects', ({ data }) => !data.draft);
  const paths = [];

  for (const entry of entries) {
    const slug = entry.id.replace(/\.md$/, '');
    const ogImageRel = `/og/projects/${slug}.png`;
    const ogImagePath = `public${ogImageRel}`;

    await generateOgImage({
      title: entry.data.title,
      type: 'project',
      subtitle: entry.data.summary,
      outputPath: ogImagePath,
    });

    paths.push({
      params: { slug },
      props: { entry, ogImage: ogImageRel },
    });
  }

  return paths;
}

const { entry, ogImage } = Astro.props;
const { Content } = await render(entry);
---

<BaseLayout title={entry.data.title} description={entry.data.summary} image={ogImage}>
  <div class="container container--wide page">

    <div class="detail-layout g12 anim-up">
      <!-- post-hero: cols 1-9, primary border -->
      <header class="post-hero">
        <p class="post-type">// PROJECT FILE</p>
        <h1 class="post-title">{entry.data.title}</h1>
        <p class="post-date">
          {entry.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' })}
        </p>
        {entry.data.summary && <p class="post-summary">{entry.data.summary}</p>}
      </header>

      <!-- meta aside: cols 10-12, offset down -->
      <aside class="post-meta-aside anim-up anim-d1">
        {entry.data.stack.map((t: string) => <span class="tag">{t}</span>)}
        {entry.data.repoUrl && <a href={entry.data.repoUrl} target="_blank" rel="noopener" class="tag">source ↗</a>}
        {entry.data.liveUrl && <a href={entry.data.liveUrl} target="_blank" rel="noopener" class="tag tag--filled">live ↗</a>}
      </aside>

      <!-- content: cols 1-9, aligned with header -->
      <div class="content-panel anim-up anim-d1">
        <div class="panel-head">Content</div>
        <div class="content-inner prose">
          <Content />
        </div>
      </div>
    </div>

  </div>
</BaseLayout>
