<script is:inline>
  function createDiffusionDissolve(canvas, urlA, urlB, options = {}) {
    const W = canvas.width,
      H = canvas.height;
    const ctx = canvas.getContext("2d");

    const SHADOW = options.shadow || { r: 0x08, g: 0x08, b: 0x10 };
    const LIGHT = options.light || { r: 0xb3, g: 0xb5, b: 0xff };
    const EASE = options.ease ?? 0.12;

    let grayA, pixelDataB, noise;
    let progress = 0,
      targetProgress = 0,
      animating = false;

    function loadImage(url) {
      return new Promise((resolve, reject) => {
        const img = new Image();
        img.crossOrigin = "anonymous";
        img.onload = () => resolve(img);
        img.onerror = reject;
        img.src = url;
      });
    }

    function processImage(img) {
      const off = document.createElement("canvas");
      off.width = W;
      off.height = H;
      const octx = off.getContext("2d");

      const scale = Math.max(W / img.width, H / img.height);
      const dw = img.width * scale,
        dh = img.height * scale;
      const dx = (W - dw) / 2,
        dy = (H - dh) / 2;
      octx.drawImage(img, dx, dy, dw, dh);

      return octx.getImageData(0, 0, W, H).data;
    }

    function buildNoiseField() {
      const n = new Float32Array(W * H);
      for (let i = 0; i < n.length; i++) n[i] = Math.random();
      return n;
    }

    function composite() {
      const imageData = ctx.createImageData(W, H);
      const data = imageData.data;
      for (let p = 0, i = 0; p < W * H; p++, i += 4) {
        const useB = noise[p] < progress;
        if (useB) {
          // Render real full-color image B pixel
          data[i] = pixelDataB[i];
          data[i + 1] = pixelDataB[i + 1];
          data[i + 2] = pixelDataB[i + 2];
          data[i + 3] = 255;
        } else {
          // Render continuous tone duotone image A matching site palette
          const norm = grayA[p] / 255;
          data[i] = Math.round(SHADOW.r + (LIGHT.r - SHADOW.r) * norm);
          data[i + 1] = Math.round(SHADOW.g + (LIGHT.g - SHADOW.g) * norm);
          data[i + 2] = Math.round(SHADOW.b + (LIGHT.b - SHADOW.b) * norm);
          data[i + 3] = 255;
        }
      }
      ctx.putImageData(imageData, 0, 0);
    }

    function animate() {
      const diff = targetProgress - progress;
      if (Math.abs(diff) < 0.005) {
        progress = targetProgress;
        composite();
        animating = false;
        return;
      }
      progress += diff * EASE;
      composite();
      requestAnimationFrame(animate);
    }

    function setProgress(target) {
      targetProgress = target;
      if (!animating) {
        animating = true;
        requestAnimationFrame(animate);
      }
    }

    const ready = Promise.all([loadImage(urlA), loadImage(urlB)]).then(
      ([imgA, imgB]) => {
        const dataA = processImage(imgA);
        pixelDataB = processImage(imgB);

        // Continuous luminance for full photo details
        grayA = new Uint8ClampedArray(W * H);
        for (let i = 0, p = 0; i < dataA.length; i += 4, p++) {
          grayA[p] = Math.round(
            0.299 * dataA[i] + 0.587 * dataA[i + 1] + 0.114 * dataA[i + 2],
          );
        }

        noise = buildNoiseField();
        composite();
      },
    );

    return { setProgress, ready };
  }

  function initAvatarDissolve() {
    const canvas = document.getElementById("avatar-canvas");
    const frame = document.getElementById("avatar-frame");
    if (!canvas || !frame) return;

    const dissolve = createDiffusionDissolve(
      canvas,
      "/me/mani-bw.webp",
      "/me/mani-.webp",
      {
        shadow: { r: 0x08, g: 0x08, b: 0x10 },
        light: { r: 0xb3, g: 0xb5, b: 0xff },
        ease: 0.12,
      },
    );

    frame.addEventListener("mouseenter", () => dissolve.setProgress(1));
    frame.addEventListener("mouseleave", () => dissolve.setProgress(0));
  }

  document.addEventListener("DOMContentLoaded", initAvatarDissolve);
  document.addEventListener("astro:page-load", initAvatarDissolve);
</script>
