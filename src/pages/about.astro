---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Target Analysis // About"
  description="Target Dossier & Intelligence Analysis for Manikandan - AI & Data Science Student, Systems & Security Research."
>
  <div class="container container--wide page">
    <!-- Target Analysis Bento Grid -->
    <div class="target-bento-grid anim-up">
      <!-- 1. Header Banner Card (Full Width) -->
      <div class="bento-card bento-header">
        <div class="bento-card-head">
          <span class="classification"
            ><span class="blink">●</span> CLASSIFIED // INTEL REPORT</span
          >
          <span class="badge-live">LIVE FEED :: SYS-2026-DX</span>
        </div>
        <div class="header-content">
          <div class="header-title-group">
            <p class="target-subtitle">
              // SUBJECT DOSSIER · AI + DATA SCIENCE · CHENNAI
            </p>
            <h1 class="target-title">TARGET ANALYSIS</h1>
          </div>
          <div class="target-quick-telemetry">
            <div class="telemetry-pill">
              <span class="lbl">CLEARANCE</span>
              <span class="val glow">LEVEL 3</span>
            </div>
            <div class="telemetry-pill">
              <span class="lbl">THREAT RATING</span>
              <span class="val">CURIOUS</span>
            </div>
            <div class="telemetry-pill">
              <span class="lbl">STATUS</span>
              <span class="val status-active">● ACTIVE</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 2. Target Profile & Avatar (4 cols) -->
      <div class="bento-card bento-avatar">
        <div class="bento-card-head">SUBJECT_IMG.RAW</div>
        <div class="avatar-bento-body">
          <div class="avatar-target-frame" id="avatar-frame">
            <canvas
              id="avatar-canvas"
              width="400"
              height="400"
              class="avatar-canvas"></canvas>
            <div class="crosshair ch-tl">+</div>
            <div class="crosshair ch-tr">+</div>
            <div class="crosshair ch-bl">+</div>
            <div class="crosshair ch-br">+</div>
            <div class="avatar-overlay-badge">
              <span class="scan-status">[ SUBJECT MATCH 99.4% ]</span>
            </div>
          </div>
          <div class="avatar-metadata">
            <div class="meta-row">
              <span>CODENAME</span><strong>MANI</strong>
            </div>
            <div class="meta-row">
              <span>SPEC</span><strong>AI &amp; DATA SCIENCE</strong>
            </div>
            <div class="meta-row">
              <span>LOCATION</span><strong>CHENNAI, IN</strong>
            </div>
          </div>
        </div>
      </div>

      <!-- 3. Intelligence Briefing Bio (8 cols) -->
      <div class="bento-card bento-brief">
        <div class="bento-card-head">EXECUTIVE BRIEFING</div>
        <div class="brief-body">
          <div class="brief-fields-grid">
            <div class="brief-field">
              <span class="field-lbl">NAME</span>
              <span class="field-val">Manikandan</span>
            </div>
            <div class="brief-field">
              <span class="field-lbl">LOCATION</span>
              <span class="field-val">Chennai, India</span>
            </div>
            <div class="brief-field">
              <span class="field-lbl">FOCUS</span>
              <span class="field-val">AI Systems &amp; Security</span>
            </div>
            <div class="brief-field">
              <span class="field-lbl">OPERATIONAL STATUS</span>
              <span class="field-val status-active">● Active Deployment</span>
            </div>
          </div>
          <hr class="bento-hr" />
          <p class="brief-summary">
            Subject builds digital architectures, tests system boundaries, and
            documents security findings. Inspired by systems thinking and
            reverse engineering — driven to understand how applications function
            at their boundary conditions.
          </p>
          <div class="brief-tags">
            <span class="tag tag--filled">Systems Thinking</span>
            <span class="tag">Security Research</span>
            <span class="tag">Machine Learning</span>
          </div>
        </div>
      </div>

      <!-- 4. Technical Capabilities Vector (7 cols) -->
      <div class="bento-card bento-skills">
        <div class="bento-card-head">CAPABILITIES // TECHNICAL VECTOR</div>
        <div class="skills-body">
          <div class="skill-category">
            <div class="cat-head">LANGUAGES</div>
            <div class="tags-row">
              <span class="tag tag--filled">Python</span>
              <span class="tag">C</span>
              <span class="tag">JavaScript</span>
              <span class="tag">SQL</span>
            </div>
          </div>
          <div class="skill-category">
            <div class="cat-head">FRAMEWORKS &amp; STACK</div>
            <div class="tags-row">
              <span class="tag">PyTorch</span>
              <span class="tag">FastAPI</span>
              <span class="tag tag--filled">Astro</span>
            </div>
          </div>
          <div class="skill-category">
            <div class="cat-head">TOOLCHAIN &amp; RE</div>
            <div class="tags-row">
              <span class="tag">Linux</span>
              <span class="tag">Docker</span>
              <span class="tag">Git</span>
              <span class="tag">Ghidra</span>
            </div>
          </div>
          <div class="skill-category">
            <div class="cat-head">
              <span class="comment">&lt;!-- active research --&gt;</span>
            </div>
            <div class="tags-row">
              <span class="tag tag--learning">Rust</span>
              <span class="tag tag--learning">x86 ASM</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 5. Operational Training / Education (5 cols) -->
      <div class="bento-card bento-edu">
        <div class="bento-card-head">OPERATIONAL TRAINING</div>
        <div class="edu-body">
          <div class="edu-card-item">
            <div class="edu-badge">ACADEMIC PROGRAM</div>
            <h3 class="edu-heading">B.Tech in AI &amp; Data Science</h3>
            <p class="edu-sub">Present · Chennai, India</p>
          </div>
          <hr class="bento-hr" />
          <div class="edu-card-item">
            <div class="edu-badge">CYBERWARFARE LABS</div>
            <h3 class="edu-heading">CTF &amp; Vulnerability Analysis</h3>
            <p class="edu-sub">Ongoing Practice</p>
            <div class="tags-row" style="margin-top: 8px;">
              <span class="tag">HackTheBox</span>
              <span class="tag">PicoCTF</span>
              <span class="tag">TryHackMe</span>
            </div>
          </div>
        </div>
      </div>

      <!-- 6. Operational Experience Log (8 cols) -->
      <div class="bento-card bento-exp">
        <div class="bento-card-head">FIELD OPERATIONS // EXPERIENCE LOG</div>
        <div class="exp-body">
          <div class="timeline">
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <div class="tl-header">
                  <span class="tl-title">Independent Engineering Projects</span>
                  <span class="tl-date">2023 – PRESENT</span>
                </div>
                <p class="tl-desc">
                  Architecting full-stack web applications, custom UI
                  components, and dataset processing scripts.
                </p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <div class="tl-header">
                  <span class="tl-title"
                    >CTF Competitions &amp; Security Labs</span
                  >
                  <span class="tl-date">2024 – PRESENT</span>
                </div>
                <p class="tl-desc">
                  Analyzing web application sinks, binary exploitation pathways,
                  and publishing technical writeups.
                </p>
              </div>
            </div>
            <div class="timeline-item">
              <div class="timeline-dot"></div>
              <div class="timeline-content">
                <div class="tl-header">
                  <span class="tl-title">Open Source Contributions</span>
                  <span class="tl-date">ONGOING</span>
                </div>
                <p class="tl-desc">
                  Developing modular components, writing developer
                  documentation, and submitting code improvements.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- 7. Encrypted Comms & Signals (4 cols) -->
      <div class="bento-card bento-comms">
        <div class="bento-card-head">SIGNALS // ENCRYPTED COMMS</div>
        <div class="comms-body">
          <a href="mailto:manikandanx0@proton.me" class="comms-channel">
            <span class="ch-label">EMAIL</span>
            <span class="ch-val">manikandanx0@proton.me ↗</span>
          </a>
          <a
            href="https://github.com/manikandanx0"
            target="_blank"
            rel="noopener"
            class="comms-channel"
          >
            <span class="ch-label">GITHUB</span>
            <span class="ch-val">@manikandanx0 ↗</span>
          </a>
          <a
            href="https://linkedin.com/in/manikandannx0"
            target="_blank"
            rel="noopener"
            class="comms-channel"
          >
            <span class="ch-label">LINKEDIN</span>
            <span class="ch-val">manikandannx0 ↗</span>
          </a>
          <a href="/" class="comms-channel">
            <span class="ch-label">DOMAINS</span>
            <span class="ch-val">mani.tech</span>
          </a>
        </div>
        <div class="bento-card-footer">
          <span>PATH: C:\CLASSIFIED\SUBJECT_DX\DOSSIER.RAW</span>
          <span>SECURED</span>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* ── Bento Grid System ─────────────────────────────────── */
  /*
    Asymmetric column assignments:
    Header:  cols 1-12  (full width anchor)
    Avatar:  cols 1-4   (narrow left — content-height, NOT forced tall)
    Brief:   cols 4-12  (wide right — starts where avatar ends, slight overlap)
    Skills:  cols 2-9   (offset left edge by 1 col)
    Edu:     cols 9-13  (right panel — different height from skills)
    Exp:     cols 1-8   (dominant left)
    Comms:   cols 8-13  (right, starts at exp midpoint)
  */
  .target-bento-grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    column-gap: 12px;
    row-gap: 12px;
    width: 100%;
    align-items: start; /* content-driven heights — no forced stretching */
  }

  /* ── Card Base ────────────────────────────────────────── */
  .bento-card {
    background: rgba(10, 10, 20, 0.92);
    border: 1px solid var(--border2);
    position: relative;
    backdrop-filter: blur(3px);
    display: flex;
    flex-direction: column;
    overflow: hidden;
    transition:
      border-color 0.25s,
      box-shadow 0.25s;
  }
  .bento-card:hover {
    border-color: var(--border3);
    box-shadow: inset 0 0 24px rgba(123, 63, 228, 0.04);
  }
  .bento-card::before {
    content: "";
    position: absolute;
    top: -1px;
    left: -1px;
    width: 8px;
    height: 8px;
    border-top: 1px solid var(--border3);
    border-left: 1px solid var(--border3);
    z-index: 2;
    pointer-events: none;
    transition:
      width 0.2s,
      height 0.2s,
      border-color 0.2s;
  }
  .bento-card:hover::before {
    width: 14px;
    height: 14px;
    border-color: var(--purple);
  }

  /* header card — primary border */
  .bento-header {
    border-color: var(--border3);
  }

  /* Card Header */
  .bento-card-head {
    border-bottom: 1px solid var(--border);
    padding: 6px 14px;
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 1.5px;
    color: var(--muted);
    text-transform: uppercase;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .bento-card-head::before {
    content: "▌";
    color: var(--purple);
    opacity: 0.6;
    margin-right: 6px;
    font-size: 9px;
  }

  /* ── Asymmetric Column Assignments ─────────────────────── */
  .bento-header {
    grid-column: 1 / 13;
  } /* full width */
  .bento-avatar {
    grid-column: 1 / 4;
  } /* narrow left — 3 cols */
  .bento-brief {
    grid-column: 4 / 13;
  } /* wide right — 9 cols */
  .bento-skills {
    grid-column: 2 / 9;
  } /* offset — starts col 2 */
  .bento-edu {
    grid-column: 9 / 13;
  } /* right column — 4 cols */
  .bento-exp {
    grid-column: 1 / 8;
  } /* dominant left — 7 cols */
  .bento-comms {
    grid-column: 8 / 13;
    margin-top: 24px;
  } /* right, offset down */

  /* ── 1. Bento Header ────────────────────────────────────── */
  .classification {
    font-family: var(--font-mono);
    color: var(--violet);
    font-size: var(--text-label);
    letter-spacing: 1.5px;
  }
  .blink {
    display: inline-block;
    color: var(--violet);
    animation: pulse-dot 2s ease-in-out infinite;
  }
  @keyframes pulse-dot {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.2;
    }
  }

  .badge-live {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--muted);
    letter-spacing: 1.5px;
  }

  .header-content {
    padding: 20px 24px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
  }

  .target-subtitle {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 1.5px;
    color: var(--muted);
    margin-bottom: 6px;
    text-transform: uppercase;
  }

  .target-title {
    font-family: var(--font-display);
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: -0.5px;
    color: var(--white);
    text-transform: uppercase;
    margin: 0;
    line-height: 1.1;
  }

  .target-quick-telemetry {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .telemetry-pill {
    border: 1px solid var(--border2);
    background: rgba(8, 8, 18, 0.8);
    padding: 6px 14px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    transition: border-color 0.2s;
  }
  .telemetry-pill:hover {
    border-color: var(--border3);
  }
  .telemetry-pill .lbl {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--muted);
    letter-spacing: 1.5px;
  }
  .telemetry-pill .val {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    font-weight: 600;
    color: var(--white);
  }
  .status-active {
    color: var(--glow);
  }

  /* ── 2. Bento Avatar ────────────────────────────────────── */
  .avatar-bento-body {
    padding: 14px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .avatar-target-frame {
    border: 1px solid var(--border2);
    aspect-ratio: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    overflow: hidden;
    background: var(--surface);
    cursor: pointer;
  }

  .avatar-canvas {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .crosshair {
    position: absolute;
    font-family: var(--font-mono);
    font-size: 10px;
    color: var(--purple);
    line-height: 1;
    opacity: 0.7;
    z-index: 3;
    pointer-events: none;
  }
  .ch-tl {
    top: 6px;
    left: 8px;
  }
  .ch-tr {
    top: 6px;
    right: 8px;
  }
  .ch-bl {
    bottom: 6px;
    left: 8px;
  }
  .ch-br {
    bottom: 6px;
    right: 8px;
  }

  .avatar-overlay-badge {
    position: absolute;
    bottom: 8px;
    left: 50%;
    transform: translateX(-50%);
    z-index: 5;
    background: rgba(8, 8, 20, 0.85);
    border: 1px solid var(--border2);
    padding: 3px 8px;
    backdrop-filter: blur(4px);
    white-space: nowrap;
    transition: border-color 0.3s ease;
  }
  .avatar-target-frame:hover .avatar-overlay-badge {
    border-color: var(--purple);
  }

  .scan-status {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--muted);
    letter-spacing: 1.5px;
  }

  .avatar-metadata {
    display: flex;
    flex-direction: column;
    gap: 5px;
    border-top: 1px solid var(--border);
    padding-top: 10px;
  }
  .meta-row {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 1.2px;
    gap: 8px;
    min-width: 0;
  }
  .meta-row span {
    color: var(--muted);
    flex-shrink: 0;
  }
  .meta-row strong {
    color: var(--text);
    font-weight: 500;
    text-align: right;
    word-break: break-word;
    min-width: 0;
  }

  /* ── 3. Bento Briefing ─────────────────────────────────── */
  .brief-body {
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 14px;
    flex: 1;
  }

  .brief-fields-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 10px 20px;
  }

  .brief-field {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .field-lbl {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 1.5px;
    color: var(--muted);
    text-transform: uppercase;
  }
  .field-val {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--white);
  }

  .bento-hr {
    border: none;
    border-top: 1px solid var(--border);
    margin: 0;
  }
  .brief-summary {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--text);
    line-height: 1.8;
  }
  .brief-tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    margin-top: auto;
    padding-top: 4px;
  }

  /* ── 4. Bento Skills ───────────────────────────────────── */
  .skills-body {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .skill-category {
    display: flex;
    flex-direction: column;
    gap: 5px;
  }
  .cat-head {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 1.5px;
    color: var(--muted);
    text-transform: uppercase;
  }
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
  }
  .tag--learning {
    border-style: dashed;
    border-color: var(--border3);
    color: var(--muted);
  }

  /* ── 5. Bento Education ────────────────────────────────── */
  .edu-body {
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 12px;
    flex: 1;
  }

  .edu-card-item {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .edu-badge {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 1.5px;
    color: var(--purple);
    opacity: 0.8;
  }
  .edu-heading {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 600;
    color: var(--white);
    margin: 0;
    letter-spacing: 1px;
    text-transform: uppercase;
    word-break: break-word;
    overflow-wrap: break-word;
  }
  .edu-sub {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 1.2px;
    color: var(--muted);
    margin: 0;
  }

  /* ── 6. Bento Experience ───────────────────────────────── */
  .exp-body {
    padding: 16px 20px;
  }

  .timeline {
    display: flex;
    flex-direction: column;
    gap: 18px;
    position: relative;
    padding-left: 16px;
  }
  .timeline::before {
    content: "";
    position: absolute;
    top: 6px;
    bottom: 6px;
    left: 3px;
    width: 1px;
    background: linear-gradient(to bottom, var(--border3), transparent);
  }

  .timeline-item {
    position: relative;
  }

  .timeline-dot {
    position: absolute;
    left: -16px;
    top: 5px;
    width: 6px;
    height: 6px;
    background: var(--purple);
    border-radius: 50%;
    box-shadow: 0 0 6px rgba(123, 63, 228, 0.5);
  }

  .timeline-content {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .tl-header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 8px;
  }
  .tl-title {
    font-family: var(--font-display);
    font-size: var(--text-h2);
    font-weight: 600;
    color: var(--white);
    letter-spacing: 1px;
    text-transform: uppercase;
  }
  .tl-date {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    color: var(--violet);
    letter-spacing: 1.5px;
    opacity: 0.8;
  }
  .tl-desc {
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--muted);
    margin: 0;
    line-height: 1.65;
  }

  /* ── 7. Bento Comms ────────────────────────────────────── */
  .comms-body {
    padding: 12px 14px;
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1;
  }

  .comms-channel {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 9px 12px;
    border: 1px solid var(--border);
    background: transparent;
    transition:
      border-color 0.2s,
      background 0.2s;
  }
  .comms-channel:hover {
    border-color: var(--border2);
    background: rgba(123, 63, 228, 0.05);
  }
  .ch-label {
    font-family: var(--font-mono);
    font-size: var(--text-label);
    letter-spacing: 1.5px;
    color: var(--muted);
    text-transform: uppercase;
  }
  .ch-val {
    font-family: var(--font-mono);
    font-size: var(--text-meta);
    letter-spacing: 1.2px;
    color: var(--violet);
    transition: color 0.2s;
  }
  .comms-channel:hover .ch-val {
    color: var(--glow);
  }

  .bento-card-footer {
    border-top: 1px solid var(--border);
